{% comment %}
  Urban Essentials — Category tiles ("Pick a category 👇")
  Round, pastel-backed collection tiles. Add one block per collection; with no
  blocks it shows the store's first collections automatically.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap">


{%- style -%}
  #ue-cats-{{ section.id }} { --ue-cats-bg: {{ section.settings.background }}; }
{%- endstyle -%}

{%- liquid
  assign pastels = '#fde2e4,#d8f3e8,#fff1c1,#e9e3ff,#dcefff,#ffe4cc' | split: ','
-%}

<section id="ue-cats-{{ section.id }}" class="ue-cats" aria-labelledby="ue-cats-heading-{{ section.id }}">
  <div class="page-width">
    <div class="ue-cats__head">
      <h2 id="ue-cats-heading-{{ section.id }}" class="ue-cats__title ue-font-playful">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="ue-cats__all" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <ul class="ue-cats__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- assign tint_index = forloop.index0 | modulo: 6 -%}{%- assign tint = pastels[tint_index] -%}
          <li {{ block.shopify_attributes }}>
            <a class="ue-cats__tile" href="{% if c != blank %}{{ c.url }}{% else %}#{% endif %}">
              <span class="ue-cats__circle" style="background: {{ tint }};">
                {%- assign img = block.settings.image | default: c.featured_image -%}
                {%- if img != blank -%}
                  {{ img | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 990px) 15vw, 30vw', alt: '' }}
                {%- else -%}
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'ue-cats__ph' }}
                {%- endif -%}
              </span>
              <span class="ue-cats__label">{{ block.settings.title | default: c.title | default: 'Collection' }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections limit: 12 -%}
          {%- if c.handle == 'frontpage' or c.handle == 'all' -%}{%- continue -%}{%- endif -%}
          {%- assign tint_index = forloop.index0 | modulo: 6 -%}{%- assign tint = pastels[tint_index] -%}
          <li>
            <a class="ue-cats__tile" href="{{ c.url }}">
              <span class="ue-cats__circle" style="background: {{ tint }};">
                {%- if c.featured_image != blank -%}
                  {{ c.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 990px) 15vw, 30vw', alt: '' }}
                {%- endif -%}
              </span>
              <span class="ue-cats__label">{{ c.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ue-font-playful { font-family: 'Fredoka', var(--font-heading-family), sans-serif; letter-spacing: -0.01em; }
  .ue-cats { background: var(--ue-cats-bg); padding: 4rem 0; }
  @media screen and (min-width: 750px) { .ue-cats { padding: 6rem 0; } }
  .ue-cats__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.6rem; margin-bottom: 2.8rem; }
  .ue-cats__title { margin: 0; font-size: clamp(2.4rem, 4vw, 3.8rem); font-weight: 600; }
  .ue-cats__all { flex-shrink: 0; font-weight: 700; font-size: 1.4rem; color: #ff6f61; text-decoration: none; }
  .ue-cats__all:hover { text-decoration: underline; }
  .ue-cats__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem 1.2rem; }
  @media screen and (min-width: 750px) { .ue-cats__grid { grid-template-columns: repeat(4, 1fr); gap: 2.8rem 2.4rem; } }
  @media screen and (min-width: 990px) { .ue-cats__grid { grid-template-columns: repeat(6, 1fr); } }
  .ue-cats__tile { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; text-decoration: none; color: inherit; }
  .ue-cats__circle { display: block; width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 4px solid #fff; box-shadow: 0 8px 20px rgba(43,34,32,.08); transition: transform .3s, box-shadow .3s; }
  .ue-cats__circle img, .ue-cats__ph { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .ue-cats__tile:hover .ue-cats__circle { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(43,34,32,.14); }
  .ue-cats__tile:hover img { transform: scale(1.05); }
  .ue-cats__label { font-weight: 700; font-size: 1.2rem; line-height: 1.25; }
  @media screen and (min-width: 750px) { .ue-cats__label { font-size: 1.4rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "UE Category tiles",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a category 👇" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all →" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to all collections." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom label (optional)" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)", "info": "Defaults to the collection image." }
      ]
    }
  ],
  "presets": [
    { "name": "UE Category tiles" }
  ]
}
{% endschema %}

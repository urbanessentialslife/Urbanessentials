{% comment %}
  Urban Essentials — Playful hero
  Pastel background, rounded headline with a highlighted word, two buttons,
  three trust points and a floating collage of up to 5 product cut-outs
  (transparent PNG/WebP work best), each with a pastel backdrop and an
  optional sticker.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap">

{%- style -%}
  #ue-hero-{{ section.id }} {
    --ue-bg: {{ section.settings.background }};
    --ue-accent: {{ section.settings.accent }};
    --ue-ink: {{ section.settings.text_color }};
  }
{%- endstyle -%}

<section id="ue-hero-{{ section.id }}" class="ue-hero" aria-label="{{ section.settings.heading_start | escape }}">
  <div class="ue-hero__blob ue-hero__blob--1" aria-hidden="true"></div>
  <div class="ue-hero__blob ue-hero__blob--2" aria-hidden="true"></div>
  <div class="ue-hero__blob ue-hero__blob--3" aria-hidden="true"></div>

  <div class="ue-hero__inner page-width">
    <div class="ue-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ue-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="ue-hero__heading ue-font-playful">
        {{ section.settings.heading_start }}
        {%- if section.settings.heading_highlight != blank -%}
          {{ ' ' }}<span class="ue-hero__highlight">
            {{- section.settings.heading_highlight -}}
            <svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 C 40 4, 80 4, 110 10 S 170 18, 197 6" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
          </span>
        {%- endif -%}
        {%- if section.settings.heading_end != blank -%}{{ ' ' }}{{ section.settings.heading_end }}{%- endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="ue-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="ue-hero__buttons">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="ue-btn ue-btn--primary">{{ section.settings.button_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="ue-btn ue-btn--secondary">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>

      <ul class="ue-hero__trust">
        {%- for i in (1..3) -%}
          {%- liquid
            assign key = 'trust_' | append: i
            assign trust = section.settings[key]
          -%}
          {%- if trust != blank -%}<li>{{ trust }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="ue-hero__collage">
      {%- for block in section.blocks limit: 5 -%}
        <div class="ue-hero__item ue-hero__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="ue-hero__float" style="--ue-tilt: {{ block.settings.tilt }}deg; animation-delay: {{ forloop.index0 | times: 0.4 }}s;">
            <span class="ue-hero__backdrop" style="background: {{ block.settings.backdrop }};" aria-hidden="true"></span>
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.index <= 2
                  assign loading = 'eager'
                endif
              -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: loading, widths: '300, 500, 700', sizes: '(min-width: 990px) 20vw, 35vw', class: 'ue-hero__img', alt: block.settings.image.alt }}
            {%- elsif block.settings.asset != blank -%}
              <img
                src="{{ block.settings.asset | asset_url }}"
                alt="{{ block.settings.alt | escape }}"
                width="800"
                height="1200"
                class="ue-hero__img"
                {% if forloop.first %}fetchpriority="high"{% endif %}
                decoding="async"
              >
            {%- else -%}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'ue-hero__img ue-hero__img--placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.sticker != blank -%}
            <span class="ue-hero__sticker ue-hero__sticker--{{ block.settings.sticker_style }} ue-font-playful" aria-hidden="true">{{ block.settings.sticker }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ue-font-playful { font-family: 'Fredoka', var(--font-heading-family), sans-serif; letter-spacing: -0.01em; }
  .ue-hero { position: relative; overflow: hidden; background: var(--ue-bg); color: var(--ue-ink); padding: 3rem 0 3.5rem; }
  .ue-hero__blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .8; pointer-events: none; }
  .ue-hero__blob--1 { width: 24rem; height: 24rem; top: -8rem; left: -8rem; background: #fde2e4; }
  .ue-hero__blob--2 { width: 28rem; height: 28rem; top: 30%; right: -9rem; background: #d8f3e8; }
  .ue-hero__blob--3 { width: 20rem; height: 20rem; bottom: -8rem; left: 35%; background: #fff1c1; }
  .ue-hero__inner { position: relative; display: grid; gap: 2rem; align-items: center; }
  .ue-hero__copy { order: 2; text-align: center; }
  .ue-hero__collage { order: 1; position: relative; width: 100%; max-width: 30rem; margin: 0 auto; aspect-ratio: 5 / 4; }
  @media screen and (min-width: 990px) {
    .ue-hero { padding: 5rem 0 6rem; }
    .ue-hero__inner { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .ue-hero__copy { order: 1; text-align: left; }
    .ue-hero__collage { order: 2; max-width: none; }
  }
  .ue-hero__eyebrow { display: inline-block; background: #fff; color: var(--ue-accent); font-weight: 700; font-size: 1.2rem; padding: .6rem 1.4rem; border-radius: 99px; transform: rotate(-2deg); box-shadow: 0 4px 14px rgba(255,111,97,.18); }
  .ue-hero__heading { margin: 1.6rem 0 0; font-size: clamp(3.8rem, 9vw, 7.2rem); line-height: 1.02; font-weight: 600; color: var(--ue-ink); }
  .ue-hero__highlight { position: relative; display: inline-block; color: var(--ue-accent); }
  .ue-hero__highlight svg { position: absolute; left: 0; bottom: -.6rem; width: 100%; height: 1.2rem; color: #ffb4a8; }
  .ue-hero__text { margin-top: 2rem; font-size: 1.6rem; line-height: 1.6; opacity: .85; max-width: 48rem; margin-left: auto; margin-right: auto; }
  .ue-hero__text p { margin: 0; }
  @media screen and (min-width: 990px) { .ue-hero__text { margin-left: 0; font-size: 1.8rem; } }
  .ue-hero__buttons { margin-top: 2.8rem; display: flex; flex-direction: column; gap: 1.2rem; justify-content: center; }
  @media screen and (min-width: 750px) { .ue-hero__buttons { flex-direction: row; } }
  @media screen and (min-width: 990px) { .ue-hero__buttons { justify-content: flex-start; } }
  .ue-btn { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; padding: 1.5rem 3rem; border-radius: 99px; font-weight: 700; font-size: 1.4rem; text-decoration: none; transition: transform .2s, background .2s, border-color .2s, color .2s; }
  .ue-btn--primary { background: var(--ue-accent); color: #fff; box-shadow: 0 12px 28px rgba(255,111,97,.35); }
  .ue-btn--primary:hover { transform: translateY(-2px); filter: brightness(.95); }
  .ue-btn--secondary { background: #fff; color: var(--ue-ink); border: 2px solid rgba(43,34,32,.1); }
  .ue-btn--secondary:hover { border-color: var(--ue-accent); color: var(--ue-accent); }
  .ue-hero__trust { list-style: none; padding: 0; margin: 2.6rem 0 0; display: flex; flex-wrap: wrap; gap: .8rem 2rem; justify-content: center; font-size: 1.3rem; opacity: .85; }
  @media screen and (min-width: 990px) { .ue-hero__trust { justify-content: flex-start; } }

  .ue-hero__item { position: absolute; }
  .ue-hero__item--1 { left: 30%; top: 6%; width: 38%; z-index: 3; }
  .ue-hero__item--2 { left: 2%; top: 30%; width: 28%; z-index: 2; }
  .ue-hero__item--3 { right: 2%; top: 18%; width: 30%; z-index: 2; }
  .ue-hero__item--4 { left: 16%; bottom: 0; width: 24%; z-index: 4; }
  .ue-hero__item--5 { right: 12%; bottom: 2%; width: 30%; z-index: 4; }
  .ue-hero__float { position: relative; transform: rotate(var(--ue-tilt, 0deg)); animation: ue-float 5.5s ease-in-out infinite; }
  .ue-hero__backdrop { position: absolute; left: 8%; right: 8%; top: 18%; bottom: 4%; border-radius: 2.4rem; }
  .ue-hero__img { position: relative; display: block; width: 100%; height: auto; filter: drop-shadow(0 14px 18px rgba(43,34,32,.18)); }
  .ue-hero__img--placeholder { background: rgba(255,255,255,.6); border-radius: 2.4rem; }
  .ue-hero__sticker { position: absolute; top: -.4rem; left: -.4rem; z-index: 5; font-size: 1.1rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; padding: .4rem 1rem; border-radius: 99px; box-shadow: 0 6px 16px rgba(43,34,32,.12); transform: rotate(-8deg); white-space: nowrap; }
  .ue-hero__sticker--coral { background: #ff6f61; color: #fff; }
  .ue-hero__sticker--white { background: #fff; color: #2b2220; }
  .ue-hero__sticker--dark { background: #2b2220; color: #fff; }
  @keyframes ue-float { 0%, 100% { transform: translateY(0) rotate(var(--ue-tilt, 0deg)); } 50% { transform: translateY(-10px) rotate(var(--ue-tilt, 0deg)); } }
  @media (prefers-reduced-motion: reduce) { .ue-hero__float { animation: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "UE Playful hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "✿ The everyday edit · free delivery across India" },
    { "type": "text", "id": "heading_start", "label": "Heading (start)", "default": "Essentials that make you" },
    { "type": "text", "id": "heading_highlight", "label": "Heading (highlighted word)", "default": "smile" },
    { "type": "text", "id": "heading_end", "label": "Heading (end)", "default": "✨" },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Colourful tumblers, cute kids' bottles, cosy mugs and home décor — premium everyday essentials that are fun to give and lovely to use.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop bestsellers →" },
    { "type": "text", "id": "button_1_link", "label": "Button 1 link", "default": "#top-sellers", "info": "A page address like /collections/all, or #top-sellers / #budget to jump down the homepage." },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Shop by budget" },
    { "type": "text", "id": "button_2_link", "label": "Button 2 link", "default": "#budget" },
    { "type": "header", "content": "Trust points" },
    { "type": "text", "id": "trust_1", "label": "Point 1", "default": "🚚 Free delivery" },
    { "type": "text", "id": "trust_2", "label": "Point 2", "default": "📦 Dispatch in 24 hours" },
    { "type": "text", "id": "trust_3", "label": "Point 3", "default": "✍️ Personalise select bottles" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fff8f1" },
    { "type": "color", "id": "accent", "label": "Accent (buttons, highlight)", "default": "#ff6f61" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2220" }
  ],
  "blocks": [
    {
      "type": "product_image",
      "name": "Product cut-out",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Transparent PNG/WebP cut-outs look best (around 800×1200)." },
        { "type": "text", "id": "asset", "label": "Built-in image file (used when no image is picked)", "info": "A file name from the theme's assets folder, e.g. ue-cutout-tumbler-pink.webp" },
        { "type": "text", "id": "alt", "label": "Image description (for accessibility)" },
        { "type": "color", "id": "backdrop", "label": "Pastel backdrop", "default": "#fde2e4" },
        { "type": "range", "id": "tilt", "label": "Tilt", "min": -10, "max": 10, "step": 1, "unit": "°", "default": 0 },
        { "type": "text", "id": "sticker", "label": "Sticker text (optional)", "info": "e.g. New!, Kids' fav 🐰, Bestseller ★" },
        { "type": "select", "id": "sticker_style", "label": "Sticker style", "default": "coral", "options": [
          { "value": "coral", "label": "Coral" },
          { "value": "white", "label": "White" },
          { "value": "dark", "label": "Dark" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "UE Playful hero",
      "blocks": [
        { "type": "product_image", "settings": { "backdrop": "#fde2e4", "tilt": -4, "sticker": "New!", "sticker_style": "coral" } },
        { "type": "product_image", "settings": { "backdrop": "#fff1c1", "tilt": 6, "sticker": "Kids' fav 🐰", "sticker_style": "white" } },
        { "type": "product_image", "settings": { "backdrop": "#dcefff", "tilt": 5, "sticker": "Bestseller ★", "sticker_style": "dark" } },
        { "type": "product_image", "settings": { "backdrop": "#e9e3ff", "tilt": -6 } },
        { "type": "product_image", "settings": { "backdrop": "#d8f3e8", "tilt": 3 } }
      ]
    }
  ]
}
{% endschema %}
